{
  "name": "@flex-development/docast-util-from-comments",
  "description": "docast utility to turn comments into syntax trees",
  "version": "0.0.0",
  "keywords": [
    "ast",
    "docast",
    "syntax-tree",
    "unist",
    "util"
  ],
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/flex-development/docast/tree/main/packages/docast-util-from-comments",
  "repository": {
    "directory": "packages/docast-util-from-comments",
    "type": "git",
    "url": "git+https://github.com/flex-development/docast.git"
  },
  "bugs": "https://github.com/flex-development/docast/issues",
  "author": {
    "name": "Lexus Drumgold",
    "url": "https://github.com/unicornware"
  },
  "publishConfig": {
    "access": "public",
    "diff-dst-prefix": "docast-util-from-comments",
    "diff-src-prefix": "docast-util-from-comments",
    "directory": "./",
    "executableFiles": [],
    "node-options": null,
    "pack-destination": ".",
    "parseable": true,
    "prefer-dedupe": true,
    "provenance": true,
    "tag-version-prefix": "docast-util-from-comments@"
  },
  "type": "module",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "docast": "./src/index.mts",
      "default": "./dist/index.d.mts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "dependencies": {
    "@flex-development/docast": "workspace:1.0.0-beta.6",
    "@flex-development/docast-compiler-types": "workspace:0.0.0",
    "@flex-development/docast-util-symbol": "workspace:0.0.0",
    "@flex-development/docmark": "1.0.0-alpha.21",
    "@flex-development/docmark-util-symbol": "1.0.0-alpha.13",
    "@flex-development/docmark-util-types": "1.0.0-alpha.21",
    "@flex-development/mark": "1.0.0-alpha.12",
    "@flex-development/mark-compiler": "1.0.0-alpha.10",
    "@flex-development/mdast-util-from-markdown": "2.0.0",
    "@flex-development/unist-util-builder": "2.0.0",
    "devlop": "1.1.0",
    "mdast-util-to-string": "4.0.0"
  },
  "devDependencies": {
    "@flex-development/unist-util-inspect": "1.1.0"
  },
  "sideEffects": false
}
